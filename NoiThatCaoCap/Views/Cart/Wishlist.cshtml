@model List<NoiThatCaoCap.Models.Product>

<div class="container py-5" style="min-height: 60vh; font-family: 'Montserrat', sans-serif;">
    <h2 class="text-center mb-5" style="font-size: 2.5rem; letter-spacing: 2px; font-family: 'Cormorant Garamond', serif;">DANH SÁCH MONG ƯỚC</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-heart text-muted fs-1 d-block mb-3"></i>
            <p class="text-muted">Bạn chưa lưu giữ kiệt tác nghệ thuật nào.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark rounded-0 mt-3 px-4 py-2 text-uppercase" style="font-size: 11px; letter-spacing: 2px;">Xem Sản Phẩm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6 position-relative">
                    <a asp-controller="Cart" asp-action="RemoveFromWishlist" asp-route-id="@item.Id" class="position-absolute btn btn-sm bg-white text-danger shadow-sm rounded-circle" style="top: 15px; right: 25px; z-index: 5; padding: 4px 8px;">
                        <i class="bi bi-x-lg" style="font-size: 10px;"></i>
                    </a>

                    <div class="border p-2 bg-white text-center">
                        <div style="height: 240px; overflow: hidden;">
                            <img src="@item.ImageUrl" alt="@item.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <div class="p-3">
                            <h4 style="font-size: 18px; font-family: 'Cormorant Garamond', serif;" class="text-truncate">@item.Name</h4>
                            <p class="small mb-3" style="color: #C9A961; font-weight:600;">@String.Format("{0:N0}", item.Price) VNĐ</p>

                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id" class="btn btn-dark btn-sm rounded-0 w-100 text-uppercase" style="font-size: 10px; letter-spacing: 1px;">
                                <i class="bi bi-bag-plus me-1"></i> Thêm Vào Giỏ Hàng
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>