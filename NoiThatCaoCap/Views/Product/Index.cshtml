@model IEnumerable<NoiThatCaoCap.Models.Product>

@{
    ViewData["Title"] = "Trang Chủ | Nội Thất Thượng Lưu";
}

<section class="hero-section">
    <div class="hero-bg-img">
        <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=2000" alt="Luxe Banner" />
    </div>

    <div class="hero-content text-center">
        <h1 class="font-cormorant animate-fade-in">
            Sự Thanh Lịch Vượt Thời Gian
        </h1>

        <p class="font-montserrat mt-3">
            Nội thất cao cấp được tuyển chọn cho những nhà sưu tầm hiện đại
        </p>

        <a href="#featured-collection"
           class="btn btn-gold mt-4 font-montserrat">

            KHÁM PHÁ BỘ SƯU TẬP
            <i class="bi bi-arrow-right ms-2"></i>

        </a>
    </div>
</section>

<section class="services-section py-5">

    <div class="container">

        <div class="row text-center gy-4">

            <div class="col-lg-3 col-sm-6">

                <div class="service-box">

                    <div class="service-icon">
                        <i class="bi bi-truck"></i>
                    </div>

                    <h5>MIỄN PHÍ VẬN CHUYỂN</h5>

                    <p>Áp dụng cho đơn hàng trên 50 triệu</p>

                </div>
            </div>

            <div class="col-lg-3 col-sm-6">

                <div class="service-box">

                    <div class="service-icon">
                        <i class="bi bi-award"></i>
                    </div>

                    <h5>CHẤT LƯỢNG CAO CẤP</h5>

                    <p>Chế tác thủ công độc bản nghệ thuật</p>

                </div>
            </div>

            <div class="col-lg-3 col-sm-6">

                <div class="service-box">

                    <div class="service-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h5>THANH TOÁN AN TOÀN</h5>

                    <p>Bảo mật thông tin khách hàng 100%</p>

                </div>
            </div>

            <div class="col-lg-3 col-sm-6">

                <div class="service-box">

                    <div class="service-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <h5>HỖ TRỢ 24/7</h5>

                    <p>Dịch vụ quản gia tư vấn tận tâm</p>

                </div>
            </div>

        </div>
    </div>
</section>

<section class="collection-section py-5" id="featured-collection">

    <div class="container text-center mb-5">

        <h2 class="font-cormorant section-title">
            Bộ Sưu Tập Nổi Bật
        </h2>

        <p class="font-montserrat text-muted subtitle-text">
            Những tuyệt tác định nghĩa không gian sống thượng lưu
        </p>

    </div>

    <div class="container">

        <div class="row">

            <!-- SIDEBAR -->
            <aside class="col-lg-3 col-md-4 mb-5 pe-lg-4">

                <form asp-controller="Product"
                      asp-action="Index"
                      method="get"
                      class="sidebar-filter-wrapper p-4 bg-light"
                      style="border-radius:8px;">

                    <h4 class="mb-4">
                        Lọc Sản Phẩm
                    </h4>

                    <!-- DANH MỤC -->
                    <div class="mb-4">

                        <h6>Danh mục</h6>

                        @foreach (var category in ViewBag.Categories)
                        {
                            <div>

                                <input type="checkbox"
                                       name="categories"
                                       value="@category.Id"
                                @(ViewBag.SelectedCategories.Contains(category.Id) ? "checked" : "") />

                                @category.Name

                            </div>
                        }

                    </div>

                    <!-- MỨC GIÁ -->
                    <div class="mb-4">

                        <h6>Mức giá</h6>

                        <div>
                            <input type="checkbox"
                                   name="prices"
                                   value="Under20"
                            @(ViewBag.SelectedPrices.Contains("Under20") ? "checked" : "") />

                            Dưới 20 triệu
                        </div>

                        <div>
                            <input type="checkbox"
                                   name="prices"
                                   value="20to50"
                            @(ViewBag.SelectedPrices.Contains("20to50") ? "checked" : "") />

                            20 - 50 triệu
                        </div>

                        <div>
                            <input type="checkbox"
                                   name="prices"
                                   value="50to100"
                            @(ViewBag.SelectedPrices.Contains("50to100") ? "checked" : "") />

                            50 - 100 triệu
                        </div>

                        <div>
                            <input type="checkbox"
                                   name="prices"
                                   value="Above100"
                            @(ViewBag.SelectedPrices.Contains("Above100") ? "checked" : "") />

                            Trên 100 triệu
                        </div>

                    </div>

                    <!-- CHẤT LIỆU -->
                    <div class="mb-4">

                        <h6>Chất liệu</h6>

                        <div>
                            <input type="checkbox"
                                   name="materials"
                                   value="Gỗ Óc Chó"
                            @(ViewBag.SelectedMaterials.Contains("Gỗ Óc Chó") ? "checked" : "") />

                            Gỗ Óc Chó
                        </div>

                        <div>
                            <input type="checkbox"
                                   name="materials"
                                   value="Gỗ Sồi"
                            @(ViewBag.SelectedMaterials.Contains("Gỗ Sồi") ? "checked" : "") />

                            Gỗ Sồi
                        </div>

                        <div>
                            <input type="checkbox"
                                   name="materials"
                                   value="Da"
                            @(ViewBag.SelectedMaterials.Contains("Da") ? "checked" : "") />

                            Da
                        </div>

                    </div>

                    <button type="submit"
                            class="btn btn-dark w-100">

                        Áp Dụng Lọc

                    </button>

                </form>

            </aside>

            <!-- PRODUCT -->
            <div class="col-lg-9 col-md-8">

                <!-- TOP ACTION -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

                    <p class="font-montserrat text-muted m-0">
                        Hiển thị <b>@Model.Count()</b> tuyệt tác nội thất
                    </p>

                    <div class="d-flex gap-2">

                        <!-- THÊM DANH MỤC -->
                        <a asp-controller="Category"
                           asp-action="Add"
                           class="btn font-montserrat fw-bold text-uppercase"
                           style="background-color: #bfa15f;
                                  color: #fff;
                                  border: 1px solid #bfa15f;
                                  padding: 8px 20px;
                                  border-radius: 4px;
                                  font-size: 13px;
                                  letter-spacing: 1px;">

                            <i class="bi bi-tags-fill me-2"></i>
                            Thêm Danh Mục

                        </a>

                        <!-- THÊM SẢN PHẨM -->
                        <a asp-controller="Product"
                           asp-action="Add"
                           class="btn font-montserrat fw-bold text-uppercase"
                           style="background-color: #111;
                                  color: #fff;
                                  border: 1px solid #bfa15f;
                                  padding: 8px 20px;
                                  border-radius: 4px;
                                  font-size: 13px;
                                  letter-spacing: 1px;">

                            <i class="bi bi-plus-lg me-2"
                               style="color: #bfa15f;"></i>

                            Thêm Sản Phẩm Mới

                        </a>

                    </div>

                </div>

                <!-- DANH SÁCH SẢN PHẨM -->
                <div class="row gy-4">

                    @foreach (var item in Model)
                    {
                        <div class="col-lg-4 col-md-6 col-sm-6">

                            <div class="product-card-premium">

                                <div class="img-wrapper">

                                    <img src="@item.ImageUrl"
                                         alt="@item.Name"
                                         class="img-fluid w-100"
                                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1524758631624-e2822e304c36?q=80&w=600';" />

                                    <div class="action-overlay-btn">

                                        <a asp-action="Detail"
                                           asp-route-id="@item.Id"
                                           class="btn-view-detail"
                                           title="Xem nhanh">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-controller="Cart"
                                           asp-action="AddToWishlist"
                                           asp-route-id="@item.Id"
                                           class="btn-wishlist-product"
                                           title="Yêu thích">

                                            <i class="bi bi-heart"></i>

                                        </a>

                                        <a asp-controller="Cart"
                                           asp-action="AddToCart"
                                           asp-route-id="@item.Id"
                                           class="btn-cart-product"
                                           title="Thêm vào giỏ">

                                            <i class="bi bi-bag-plus"></i>

                                        </a>

                                        <a asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="btn-edit-product"
                                           title="Sửa">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn-delete-product"
                                           title="Xóa">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </div>

                                <div class="product-info-box text-start mt-3">

                                    <span class="category-tag text-uppercase"
                                          style="font-size: 11px;
                                                 color: #bfa15f;
                                                 font-weight: 600;
                                                 letter-spacing: 0.5px;">

                                        @(item.Category?.Name ?? "NỘI THẤT CAO CẤP")

                                    </span>

                                    <h5 class="product-name-title font-cormorant mt-1 mb-1">

                                        <a asp-action="Detail"
                                           asp-route-id="@item.Id"
                                           class="text-dark text-decoration-none">

                                            @item.Name

                                        </a>

                                    </h5>

                                    <p class="product-price-vn font-montserrat fw-bold"
                                       style="color: #bfa15f;">

                                        @String.Format("{0:N0}", item.Price) VNĐ

                                    </p>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <!-- XEM TẤT CẢ -->
                <div class="text-center mt-5 pt-3">

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-view-all font-montserrat"
                       style="text-decoration: none;
                              border: 1px solid #333;
                              padding: 10px 25px;
                              color: #333;">

                        XEM TẤT CẢ SẢN PHẨM

                        <i class="bi bi-arrow-right ms-2"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="story-section py-5 my-5">

    <div class="container-fluid p-0">

        <div class="row g-0 align-items-center">

            <div class="col-lg-6 p-5 bg-cream d-flex flex-column justify-content-center align-items-start text-start"
                 style="min-height: 500px;
                        background-color: #f9f8f6;">

                <div class="story-wrapper-padding"
                     style="max-width: 500px;
                            margin: 0 auto;">

                    <h2 class="font-cormorant mb-4"
                        style="font-size: 2.8rem;
                               font-weight: 500;">

                        Chế Tác Hoàn Hảo

                    </h2>

                    <p class="font-montserrat text-muted mb-4"
                       style="line-height: 1.8;
                              font-size: 14px;">

                        Mỗi sản phẩm trong bộ sưu tập của chúng tôi đều được lựa chọn tỉ mỉ từ những nghệ nhân lành nghề nhất trên thế giới.

                    </p>

                    <p class="font-montserrat text-muted mb-4"
                       style="line-height: 1.8;
                              font-size: 14px;">

                        Từ đá thạch anh tự nhiên nguyên khối của Ý cho đến các thớ gỗ quý được khai thác bền vững.

                    </p>

                    <a href="#"
                       class="btn-discover font-montserrat mt-2 text-dark text-decoration-none fw-bold"
                       style="border-bottom: 1px solid #333;
                              padding-bottom: 2px;">

                        KHÁM PHÁ CÂU CHUYỆN

                        <i class="bi bi-arrow-right ms-2"></i>

                    </a>

                </div>

            </div>

            <div class="col-lg-6">

                <div class="story-img-box">

                    <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?q=80&w=1200"
                         alt="Story Interior"
                         class="img-fluid w-100"
                         style="object-fit: cover;
                                min-height: 500px;
                                max-height: 600px;" />

                </div>

            </div>

        </div>

    </div>

</section>
