@model NoiThatCaoCap.Models.Product

@{
    ViewData["Title"] = "Thêm Tuyệt Tác Mới";
}

<div class="container my-5" style="max-width: 700px;">
    <h2 class="font-cinzel text-uppercase mb-4 text-center">Thêm Sản Phẩm Mới</h2>
    <hr />

    <form asp-action="Add" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">Tên Sản Phẩm</label>
            <input asp-for="Name" class="form-control" placeholder="Ví dụ: Luxury Sofa Italia" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label fw-bold">Giá Bán (VNĐ)</label>
                <input asp-for="Price" type="number" class="form-control" placeholder="Cơ cấu số, ví dụ: 150000000" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CategoryId" class="form-label fw-bold">Danh Mục Nội Thất</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label fw-bold">Đường Dẫn Ảnh (Đường dẫn cục bộ hoặc URL)</label>
            <input asp-for="ImageUrl" class="form-control" placeholder="Ví dụ: /images/sofa.jpg" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Material" class="form-label fw-bold">Chất Liệu</label>
                <input asp-for="Material" class="form-control" placeholder="Ví dụ: Gỗ Sồi, Nhung bọc Ý" />
                <span asp-validation-for="Material" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Origin" class="form-label fw-bold">Xuất Xứ</label>
                <input asp-for="Origin" class="form-control" placeholder="Ví dụ: Italia, Pháp, Việt Nam" />
                <span asp-validation-for="Origin" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label fw-bold">Mô Tả Sản Phẩm</label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập câu chuyện hoặc mô tả chi tiết của tuyệt tác..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-secondary px-4 text-uppercase" style="font-size: 13px; font-weight: 600;">Hủy bỏ</a>
            <button type="submit" class="btn btn-dark px-4 text-uppercase" style="font-size: 13px; font-weight: 600; background: #1a1a1a;">Lưu sản phẩm</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}