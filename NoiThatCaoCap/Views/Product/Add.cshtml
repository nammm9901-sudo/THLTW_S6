@model NoiThatCaoCap.Models.Product

@{
    ViewData["Title"] = "Thêm Tuyệt Tác Nội Thất | LUXE LIVING";
}

<style>
    :root {
        --lux-gold: #C9A961;
        --lux-dark: #0D0D0D;
        --lux-muted: #6B6B6B;
        --lux-bg-soft: #F8F5F0;
        --font-serif: 'Cormorant Garamond', serif;
        --font-sans: 'Montserrat', sans-serif;
    }

    body {
        font-family: var(--font-sans);
        color: var(--lux-dark);
        background-color: var(--lux-bg-soft);
    }

    .serif-heading {
        font-family: var(--font-serif) !important;
        font-weight: 600;
    }

    .lux-form-container {
        background: #fff;
        padding: 40px;
        border: 1px solid rgba(13, 13, 13, 0.05);
    }

    .form-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        color: var(--lux-muted);
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border-radius: 0;
        border: 1px solid rgba(13, 13, 13, 0.2);
        padding: 12px 15px;
        font-size: 14px;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--lux-gold);
            box-shadow: none;
        }

    .btn-lux-submit {
        background-color: var(--lux-dark);
        color: #fff;
        border: none;
        padding: 14px 30px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-lux-submit:hover {
            background-color: var(--lux-gold);
            color: var(--lux-dark);
        }

    .btn-lux-outline {
        background: transparent;
        border: 1px solid var(--lux-dark);
        color: var(--lux-dark);
        padding: 14px 30px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-lux-outline:hover {
            background: var(--lux-bg-soft);
        }
</style>

<div class="container py-5" style="max-width: 900px;">
    <h2 class="serif-heading text-center mb-5" style="font-size: 32px; letter-spacing: 1px;">THÊM TUYỆT TÁC MỚI</h2>

    <form asp-action="Add" method="post" enctype="multipart/form-data" class="lux-form-container shadow-sm">

        <div class="mb-4">
            <label asp-for="Name" class="form-label">Tên Sản Phẩm Tuyệt Tác</label>
            <input asp-for="Name" class="form-control" placeholder="Ví dụ: Sofa Da Bò Ý Cao Cấp..." required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <label asp-for="Price" class="form-label">Giá Bán (VNĐ)</label>
                <input asp-for="Price" type="number" step="1" min="0" class="form-control" required />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label">Danh Mục Nội Thất</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required>
                    <option value="">-- Chọn danh mục sản phẩm --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-4 p-4" style="background-color: var(--lux-bg-soft); border: 1px dashed rgba(13,13,13,0.3);">
            <label class="form-label d-block text-center mb-3">Thư Viện Hình Ảnh (Gallery)</label>
            <input type="file" name="ImageFiles" class="form-control mb-2" accept="image/*" multiple required />
            <p class="text-muted text-center mb-0" style="font-size: 12px;">
                <i class="bi bi-info-circle me-1"></i> Bấm giữ phím <strong>Ctrl</strong> (hoặc <strong>Cmd</strong>) để quét chọn nhiều ảnh cùng lúc. Ảnh đầu tiên sẽ được làm ảnh đại diện chính.
            </p>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <label asp-for="Material" class="form-label">Chất Liệu Cốt Lõi</label>
                <input asp-for="Material" class="form-control" placeholder="Ví dụ: Gỗ Óc Chó, Da Bò..." />
            </div>
            <div class="col-md-6">
                <label asp-for="Origin" class="form-label">Nguồn Gốc Xuất Xứ</label>
                <input asp-for="Origin" class="form-control" placeholder="Ví dụ: Nhập khẩu Italy..." />
            </div>
        </div>

        <div class="mb-5">
            <label asp-for="Description" class="form-label">Mô Tả Sản Phẩm Chi Tiết</label>
            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Miêu tả câu chuyện và vẻ đẹp của tuyệt tác..."></textarea>
        </div>

        <div class="d-flex justify-content-between align-items-center border-top pt-4">
            <a asp-action="Index" class="btn-lux-outline"><i class="bi bi-arrow-left me-2"></i> Trở Về Cửa Hàng</a>
            <button type="submit" class="btn-lux-submit"><i class="bi bi-check-lg me-2"></i> LƯU SẢN PHẨM</button>
        </div>
    </form>
</div>