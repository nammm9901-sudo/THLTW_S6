@model NoiThatCaoCap.Models.ApplicationUser
@using NoiThatCaoCap.Models

@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân - LUXE LIVING";
    var orders = ViewBag.Orders as List<Order> ?? new List<Order>();
}

<style>
/* ── Root tokens ── */
:root {
    --gold: #C9A961;
    --gold-light: #E8D5A3;
    --gold-dim: rgba(201,169,97,.12);
    --gold-border: rgba(201,169,97,.3);
    --dark: #111;
    --dark2: #1a1a1a;
    --cream: #F8F5F0;
    --border: #e8e2d9;
    --muted: #888;
    --sans: 'Montserrat', system-ui, sans-serif;
    --serif: 'Cormorant Garamond', Georgia, serif;
}

/* ── Layout ── */
.profile-page {
    min-height: 80vh;
    padding: 64px 0 96px;
    background: #fdfcfa;
    font-family: var(--sans);
}

.profile-hero {
    background: var(--dark);
    padding: 48px 0 56px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.profile-hero::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(201,169,97,.18) 0%, transparent 70%);
    pointer-events: none;
}

.profile-avatar {
    width: 88px; height: 88px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--dark);
    font-family: var(--serif);
    font-size: 2.4rem;
    font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
    border: 3px solid rgba(201,169,97,.4);
    box-shadow: 0 0 40px rgba(201,169,97,.25);
}

.profile-hero-name {
    font-family: var(--serif);
    font-size: 2rem;
    color: var(--cream);
    font-weight: 400;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.profile-hero-email {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: rgba(248,245,240,.5);
    text-transform: uppercase;
}

/* ── Tabs ── */
.profile-tabs {
    display: flex;
    border-bottom: 1px solid var(--border);
    margin-bottom: 40px;
    gap: 0;
}

.profile-tab {
    padding: 14px 28px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color .2s, border-color .2s;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    font-family: var(--sans);
}

.profile-tab.active, .profile-tab:hover {
    color: var(--gold);
    border-bottom-color: var(--gold);
}

.tab-pane { display: none; }
.tab-pane.active { display: block; }

/* ── Form Card ── */
.form-card {
    background: #fff;
    border: 1px solid var(--border);
    padding: 36px;
    border-radius: 2px;
}

.form-card h5 {
    font-family: var(--serif);
    font-size: 1.2rem;
    letter-spacing: 1px;
    color: var(--gold);
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
    margin-bottom: 28px;
    text-transform: uppercase;
}

.lbl {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 6px;
    display: block;
}

.input-luxe {
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 11px 14px;
    font-size: 13px;
    font-family: var(--sans);
    background: var(--cream);
    width: 100%;
    transition: border-color .2s;
    outline: none;
    color: var(--dark);
}

.input-luxe:focus {
    border-color: var(--gold);
    background: #fff;
    box-shadow: 0 0 0 3px var(--gold-dim);
}

.input-luxe:disabled {
    background: #f0ede8;
    color: #999;
    cursor: not-allowed;
}

.btn-save {
    background: var(--gold);
    color: var(--dark);
    border: none;
    border-radius: 0;
    padding: 13px 40px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    font-family: var(--sans);
    cursor: pointer;
    transition: background .25s;
}

.btn-save:hover { background: var(--gold-light); }

/* ── Alert ── */
.alert-luxe-success {
    background: rgba(201,169,97,.1);
    border: 1px solid var(--gold-border);
    color: #7a6030;
    border-radius: 0;
    padding: 12px 20px;
    font-size: 12px;
    letter-spacing: 0.3px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.alert-luxe-error {
    background: rgba(220,53,69,.07);
    border: 1px solid rgba(220,53,69,.3);
    color: #842029;
    border-radius: 0;
    padding: 12px 20px;
    font-size: 12px;
    margin-bottom: 24px;
}

/* ── Order Table ── */
.order-table-wrap {
    overflow-x: auto;
}

.order-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
}

.order-table thead tr {
    border-bottom: 2px solid var(--border);
}

.order-table th {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0 16px 12px;
}

.order-table td {
    padding: 16px;
    border-bottom: 1px solid #f0ece4;
    vertical-align: middle;
}

.order-table tbody tr:hover {
    background: rgba(201,169,97,.04);
}

.order-id {
    font-weight: 700;
    color: var(--dark);
    font-family: var(--serif);
    font-size: 15px;
}

.order-date { color: var(--muted); font-size: 11.5px; }

.order-price {
    font-weight: 700;
    color: var(--gold);
    font-size: 14px;
    white-space: nowrap;
}

/* Status badges */
.badge-status {
    display: inline-block;
    padding: 4px 12px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 20px;
}

.badge-pending  { background: rgba(255,193,7,.15);  color: #856404; border: 1px solid rgba(255,193,7,.4); }
.badge-confirmed{ background: rgba(13,110,253,.1);  color: #0d6efd; border: 1px solid rgba(13,110,253,.3);}
.badge-shipping { background: rgba(111,66,193,.1);  color: #6f42c1; border: 1px solid rgba(111,66,193,.3);}
.badge-delivered{ background: rgba(25,135,84,.1);   color: #198754; border: 1px solid rgba(25,135,84,.3); }
.badge-cancelled{ background: rgba(220,53,69,.1);   color: #dc3545; border: 1px solid rgba(220,53,69,.3); }

/* Mini product list inside order row */
.mini-products {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.mini-product-img {
    width: 44px; height: 44px;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 2px;
}

/* Empty state */
.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--muted);
}

.empty-state i { font-size: 3rem; color: var(--border); margin-bottom: 16px; }
.empty-state p { font-size: 13px; letter-spacing: 0.5px; }

/* Stats row */
.stat-pill {
    background: #fff;
    border: 1px solid var(--border);
    padding: 20px 28px;
    text-align: center;
    border-radius: 2px;
}

.stat-pill .num {
    font-family: var(--serif);
    font-size: 2rem;
    color: var(--gold);
    font-weight: 600;
    display: block;
    line-height: 1;
    margin-bottom: 6px;
}

.stat-pill .lbl-stat {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
}
</style>

<!-- HERO BANNER -->
<div class="profile-hero">
    <div class="profile-avatar">@Model.FullName[0].ToString().ToUpper()</div>
    <div class="profile-hero-name">@Model.FullName</div>
    <div class="profile-hero-email">@Model.Email</div>
</div>

<div class="profile-page">
    <div class="container">

        <!-- STATS -->
        <div class="row g-3 mb-5">
            <div class="col-4">
                <div class="stat-pill">
                    <span class="num">@orders.Count</span>
                    <span class="lbl-stat">Đơn Hàng</span>
                </div>
            </div>
            <div class="col-4">
                <div class="stat-pill">
                    <span class="num">@orders.Count(o => o.Status == OrderStatus.Delivered)</span>
                    <span class="lbl-stat">Đã Nhận</span>
                </div>
            </div>
            <div class="col-4">
                <div class="stat-pill">
                    <span class="num">@String.Format("{0:N0}", orders.Sum(o => o.TotalPrice) / 1_000_000)M</span>
                    <span class="lbl-stat">Tổng Chi</span>
                </div>
            </div>
        </div>

        <!-- TABS -->
        <div class="profile-tabs">
            <button class="profile-tab active" onclick="switchTab('info', this)">
                <i class="bi bi-person me-1"></i>Thông Tin Cá Nhân
            </button>
            <button class="profile-tab" onclick="switchTab('orders', this)">
                <i class="bi bi-clock-history me-1"></i>Lịch Sử Đơn Hàng
                @if (orders.Any())
                {
                    <span style="background:var(--gold);color:#111;border-radius:10px;padding:1px 7px;font-size:9px;margin-left:4px;">@orders.Count</span>
                }
            </button>
        </div>

        <!-- TAB: THÔNG TIN CÁ NHÂN -->
        <div id="tab-info" class="tab-pane active">

            @if (TempData["ProfileSuccess"] != null)
            {
                <div class="alert-luxe-success">
                    <i class="bi bi-check-circle-fill"></i>@TempData["ProfileSuccess"]
                </div>
            }
            @if (TempData["ProfileError"] != null)
            {
                <div class="alert-luxe-error">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["ProfileError"]
                </div>
            }

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="form-card">
                        <h5><i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Hồ Sơ</h5>

                        <form asp-action="UpdateProfile" asp-controller="Order" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-4">
                                <label class="lbl">Họ và tên</label>
                                <input type="text" name="fullName" value="@Model.FullName"
                                       class="input-luxe" placeholder="Nguyễn Văn A" required />
                            </div>

                            <div class="mb-4">
                                <label class="lbl">Email</label>
                                <input type="email" value="@Model.Email"
                                       class="input-luxe" disabled />
                                <small style="font-size:10px; color:var(--muted); margin-top:4px; display:block;">
                                    Email không thể thay đổi sau khi đăng ký.
                                </small>
                            </div>

                            <div class="mb-4">
                                <label class="lbl">Số điện thoại</label>
                                <input type="tel" name="phoneNumber" value="@Model.PhoneNumber"
                                       class="input-luxe" placeholder="0901 234 567" />
                            </div>

                            <div class="mb-5">
                                <label class="lbl">Địa chỉ giao hàng mặc định</label>
                                <textarea name="address" class="input-luxe" rows="3"
                                          placeholder="Số nhà, tên đường, phường, quận, tỉnh/thành">@Model.Address</textarea>
                            </div>

                            <button type="submit" class="btn-save">
                                <i class="bi bi-save me-2"></i>Lưu Thay Đổi
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="form-card" style="background:#fdfcfa;">
                        <h5><i class="bi bi-shield-lock me-2"></i>Bảo Mật Tài Khoản</h5>

                        <p style="font-size:12px; color:var(--muted); line-height:1.8; margin-bottom:24px;">
                            Để thay đổi mật khẩu, vui lòng sử dụng trang quản lý tài khoản Identity.
                        </p>

                        <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword"
                           style="display:inline-block; padding:11px 28px; font-size:11px; font-weight:600;
                                  letter-spacing:1.5px; text-transform:uppercase; text-decoration:none;
                                  border:1px solid var(--border); color:var(--dark); font-family:var(--sans);
                                  transition:border-color .2s, background .2s;">
                            <i class="bi bi-key me-2"></i>Đổi Mật Khẩu
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: LỊCH SỬ ĐƠN HÀNG -->
        <div id="tab-orders" class="tab-pane">
            @if (!orders.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-bag-x d-block"></i>
                    <p>Bạn chưa có đơn hàng nào.</p>
                    <a asp-controller="Product" asp-action="Index"
                       style="display:inline-block; margin-top:12px; padding:12px 32px;
                              background:var(--dark); color:var(--gold); text-decoration:none;
                              font-size:11px; letter-spacing:2px; text-transform:uppercase; font-family:var(--sans);">
                        Khám Phá Cửa Hàng
                    </a>
                </div>
            }
            else
            {
                <div class="order-table-wrap">
                    <table class="order-table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Ngày đặt</th>
                                <th>Sản phẩm</th>
                                <th>Địa chỉ giao</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in orders)
                            {
                                <tr>
                                    <td>
                                        <div class="order-id">#@order.Id</div>
                                    </td>
                                    <td>
                                        <div class="order-date">@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                        <div class="order-date">@order.OrderDate.ToString("HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="mini-products">
                                            @foreach (var d in order.OrderDetails.Take(4))
                                            {
                                                <img src="@d.ProductImageUrl" alt="@d.ProductName"
                                                     class="mini-product-img" title="@d.ProductName (×@d.Quantity)"
                                                     onerror="this.src='https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=50'" />
                                            }
                                            @if (order.OrderDetails.Count > 4)
                                            {
                                                <div class="mini-product-img d-flex align-items-center justify-content-center"
                                                     style="background:#f0ece4; font-size:10px; font-weight:700; color:var(--muted);">
                                                    +@(order.OrderDetails.Count - 4)
                                                </div>
                                            }
                                        </div>
                                        <div style="font-size:11px; color:var(--muted); margin-top:6px;">
                                            @order.OrderDetails.Sum(d => d.Quantity) sản phẩm
                                        </div>
                                    </td>
                                    <td style="max-width:180px;">
                                        <div style="font-size:12px; color:#444; line-height:1.5;">
                                            @order.ShippingAddress
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="order-price">@String.Format("{0:N0}", order.TotalPrice) đ</div>
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var (badgeClass, badgeText) = order.Status switch {
                                                OrderStatus.Pending   => ("badge-pending",   "Chờ xác nhận"),
                                                OrderStatus.Confirmed => ("badge-confirmed", "Đã xác nhận"),
                                                OrderStatus.Shipping  => ("badge-shipping",  "Đang giao"),
                                                OrderStatus.Delivered => ("badge-delivered", "Đã nhận"),
                                                OrderStatus.Cancelled => ("badge-cancelled", "Đã hủy"),
                                                _                     => ("badge-pending",   "Không rõ")
                                            };
                                        }
                                        <span class="badge-status @badgeClass">@badgeText</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>

<script>
function switchTab(name, btn) {
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.profile-tab').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    btn.classList.add('active');
}

// Tự động chuyển sang tab đơn hàng nếu có query ?tab=orders
(function(){
    if (new URLSearchParams(location.search).get('tab') === 'orders') {
        const btn = document.querySelectorAll('.profile-tab')[1];
        if (btn) switchTab('orders', btn);
    }
})();
</script>
