@model NoiThatCaoCap.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Xác Nhận Đặt Hàng - LUXE LIVING";
}

<style>
:root {
    --gold: #C9A961;
    --gold-light: #E8D5A3;
    --gold-dim: rgba(201,169,97,.12);
    --cream: #F8F5F0;
    --dark: #111;
    --border: #e0d8cc;
}

.checkout-wrap {
    min-height: 70vh;
    padding: 60px 0 80px;
    font-family: 'Montserrat', sans-serif;
    background: #fdfcfa;
}

.section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.2rem;
    letter-spacing: 2px;
    color: var(--dark);
    border-bottom: 1px solid var(--border);
    padding-bottom: 16px;
    margin-bottom: 32px;
}

.checkout-card {
    background: #fff;
    border: 1px solid var(--border);
    padding: 32px;
    margin-bottom: 24px;
}

.checkout-card h5 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--gold);
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
    margin-bottom: 20px;
}

.form-label-luxe {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 6px;
    display: block;
}

.form-control-luxe {
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 11px 14px;
    font-size: 13px;
    font-family: 'Montserrat', sans-serif;
    background: var(--cream);
    width: 100%;
    transition: border-color .2s;
    outline: none;
}

.form-control-luxe:focus {
    border-color: var(--gold);
    background: #fff;
    box-shadow: 0 0 0 3px var(--gold-dim);
}

/* Order summary table */
.summary-row {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid #f0ece4;
    align-items: center;
}

.summary-row img {
    width: 64px;
    height: 64px;
    object-fit: cover;
    flex-shrink: 0;
}

.summary-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 14px;
    font-weight: 600;
    color: var(--dark);
}

.summary-meta {
    font-size: 11px;
    color: #888;
    letter-spacing: 0.3px;
}

.summary-price {
    margin-left: auto;
    text-align: right;
    white-space: nowrap;
}

.summary-price .amount {
    font-size: 14px;
    font-weight: 700;
    color: var(--gold);
}

.total-box {
    background: var(--dark);
    padding: 24px 28px;
    margin-top: 24px;
}

.total-label {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255,255,255,.5);
}

.total-amount {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    color: var(--gold);
    font-weight: 600;
}

.btn-confirm {
    background: var(--gold);
    color: var(--dark);
    border: none;
    border-radius: 0;
    padding: 16px 0;
    width: 100%;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    font-family: 'Montserrat', sans-serif;
    cursor: pointer;
    transition: background .25s;
    margin-top: 16px;
}

.btn-confirm:hover {
    background: var(--gold-light);
}

.btn-back-cart {
    display: inline-block;
    margin-top: 12px;
    font-size: 11px;
    letter-spacing: 1px;
    color: #888;
    text-decoration: none;
    text-transform: uppercase;
    width: 100%;
    text-align: center;
    padding: 10px 0;
    border: 1px solid var(--border);
    transition: color .2s, border-color .2s;
}

.btn-back-cart:hover {
    color: var(--dark);
    border-color: #aaa;
}

.text-danger { font-size: 11px; margin-top: 4px; }
</style>

<div class="checkout-wrap">
    <div class="container">
        <h2 class="section-title text-center">XÁC NHẬN ĐẶT HÀNG</h2>

        <form asp-action="Checkout" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-5">

                <!-- LEFT: Form thông tin giao hàng -->
                <div class="col-lg-7">
                    <div class="checkout-card">
                        <h5><i class="bi bi-truck me-2"></i>Thông Tin Giao Hàng</h5>

                        <div class="mb-4">
                            <label class="form-label-luxe">Họ và tên người nhận *</label>
                            <input asp-for="ReceiverName" class="form-control-luxe" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="ReceiverName" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label-luxe">Số điện thoại *</label>
                            <input asp-for="ReceiverPhone" class="form-control-luxe" placeholder="0901 234 567" />
                            <span asp-validation-for="ReceiverPhone" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label-luxe">Địa chỉ giao hàng *</label>
                            <textarea asp-for="ShippingAddress" class="form-control-luxe" rows="3"
                                      placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố"></textarea>
                            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                        </div>

                        <div class="mb-2">
                            <label class="form-label-luxe">Ghi chú thêm</label>
                            <textarea asp-for="Note" class="form-control-luxe" rows="2"
                                      placeholder="Giao giờ hành chính, gọi trước khi giao..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: Tóm tắt đơn hàng -->
                <div class="col-lg-5">
                    <div class="checkout-card">
                        <h5><i class="bi bi-receipt me-2"></i>Đơn Hàng Của Bạn</h5>

                        @foreach (var item in Model.CartItems)
                        {
                            <div class="summary-row">
                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name"
                                     onerror="this.src='https://images.unsplash.com/photo-1524758631624-e2822e304c36?w=80'" />
                                <div style="flex:1; min-width:0;">
                                    <div class="summary-name">@item.Product.Name</div>
                                    <div class="summary-meta">SL: @item.Quantity &nbsp;×&nbsp; @String.Format("{0:N0}", item.Product.Price) đ</div>
                                </div>
                                <div class="summary-price">
                                    <span class="amount">@String.Format("{0:N0}", item.Product.Price * item.Quantity) đ</span>
                                </div>
                            </div>
                        }

                        <div class="total-box mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="total-label">Tổng thanh toán</span>
                                <span class="total-label">Miễn phí giao hàng VIP</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-end mt-2">
                                <span style="font-size:11px; color:rgba(255,255,255,.4);">@Model.CartItems.Sum(i => i.Quantity) sản phẩm</span>
                                <span class="total-amount">@String.Format("{0:N0}", Model.TotalPrice) đ</span>
                            </div>
                        </div>

                        <button type="submit" class="btn-confirm">
                            <i class="bi bi-bag-check me-2"></i>Xác Nhận Đặt Hàng
                        </button>

                        <a asp-controller="Cart" asp-action="Index" class="btn-back-cart">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại giỏ hàng
                        </a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
