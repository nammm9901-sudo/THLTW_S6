@model IEnumerable<NoiThatCaoCap.Models.Product>

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="luxe-counter">Tổng cộng @Model.Count() tác phẩm nội thất</span>
    </div>
    <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn-luxe btn-luxe-gold">
        <i class="fa-solid fa-plus me-2"></i> Thêm sản phẩm mới
    </a>
</div>

<div class="luxe-card">
    <div class="luxe-card-header d-flex justify-content-between align-items-center">
        <h2 class="luxe-card-title">Bộ Sưu Tập Sản Phẩm</h2>
        <div class="luxe-table-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchBox" placeholder="Lọc sản phẩm..." />
        </div>
    </div>

    <div class="table-responsive">
        <table class="luxe-table" id="productTable">
            <thead>
                <tr>
                    <th style="width: 80px;">Ảnh</th>
                    <th>Thông tin sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá trị</th>
                    <th>Chất liệu</th>
                    <th>Xuất xứ</th>
                    <th style="width: 120px; text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="img-wrapper">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/60x60/141414/C9A961?text=LUXE" : item.ImageUrl)"
                                     alt="@item.Name"
                                     onerror="this.src='https://placehold.co/60x60/141414/C9A961?text=LUXE'" />
                            </div>
                        </td>
                        <td>
                            <span class="product-name">@item.Name</span>
                            <span class="product-id">SKU: #@item.Id.ToString("D4")</span>
                        </td>
                        <td>
                            <span class="badge-luxe-category">@(item.Category?.Name ?? "Chưa phân loại")</span>
                        </td>
                        <td class="product-price">
                            @String.Format("{0:N0}", item.Price) ₫
                        </td>
                        <td class="text-muted-luxe">@(item.Material ?? "—")</td>
                        <td class="text-muted-luxe">@(item.Origin ?? "—")</td>
                        <td>
                            <div class="action-buttons-group">
                                <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn-action-luxe edit" title="Chỉnh sửa">
                                    <i class="fa-regular fa-pen-to-square"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn-action-luxe delete" title="Xóa bỏ">
                                    <i class="fa-regular fa-trash-can"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-table-state">
                            <i class="fa-solid fa-couch"></i>
                            <p>Không gian lưu trữ đang trống. Hãy bắt đầu bộ sưu tập đầu tiên.</p>
                            <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn-luxe btn-luxe-gold mt-2">Thêm ngay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Script lọc dữ liệu mượt mà
        document.getElementById('searchBox').addEventListener('input', function () {
            var q = this.value.toLowerCase();
            document.querySelectorAll('#productTable tbody tr:not(.empty-table-state tr)').forEach(function (row) {
                var match = row.textContent.toLowerCase().includes(q);
                row.style.opacity = match ? '1' : '0';
                row.style.display = match ? '' : 'none';
            });
        });
    </script>
}