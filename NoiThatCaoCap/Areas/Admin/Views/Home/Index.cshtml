@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="luxe-stat-card">
            <div class="stat-icon stat-icon-gold"><i class="fa-solid fa-box"></i></div>
            <div class="stat-info">
                <span class="stat-value">@ViewBag.TotalProducts</span>
                <span class="stat-label">Sản phẩm</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="luxe-stat-card">
            <div class="stat-icon stat-icon-dark"><i class="fa-solid fa-tags"></i></div>
            <div class="stat-info">
                <span class="stat-value">@ViewBag.TotalCategories</span>
                <span class="stat-label">Danh mục</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="luxe-stat-card">
            <div class="stat-icon stat-icon-gold"><i class="fa-solid fa-bag-shopping"></i></div>
            <div class="stat-info">
                <span class="stat-value">0</span>
                <span class="stat-label">Đơn hàng</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="luxe-stat-card">
            <div class="stat-icon stat-icon-dark"><i class="fa-solid fa-users"></i></div>
            <div class="stat-info">
                <span class="stat-value">0</span>
                <span class="stat-label">Khách hàng</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="luxe-card">
            <div class="luxe-card-header">
                <h2 class="luxe-card-title">Truy cập nhanh</h2>
            </div>
            <div class="p-4">
                <div class="d-flex flex-column gap-3">
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn-luxe btn-luxe-gold">
                        <i class="fa-solid fa-box me-2"></i> Quản lý sản phẩm
                    </a>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn-luxe btn-luxe-outline">
                        <i class="fa-solid fa-plus me-2"></i> Thêm sản phẩm mới
                    </a>
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn-luxe btn-luxe-outline">
                        <i class="fa-solid fa-tags me-2"></i> Quản lý danh mục
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="luxe-card">
            <div class="luxe-card-header">
                <h2 class="luxe-card-title">Thông tin hệ thống</h2>
            </div>
            <div class="p-4">
                <p class="text-muted-luxe">LUXE LIVING Admin Panel</p>
                <p class="text-muted-luxe">Phiên bản: 1.0.0</p>
                <p class="text-muted-luxe">Framework: ASP.NET Core 8.0</p>
            </div>
        </div>
    </div>
</div>

<style>
.luxe-stat-card {
    background: var(--color-card-bg, #1a1a1a);
    border: 1px solid rgba(197,168,128,0.15);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 18px;
}
.stat-icon {
    width: 54px;
    height: 54px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
}
.stat-icon-gold { background: rgba(197,168,128,0.15); color: #c5a880; }
.stat-icon-dark { background: rgba(255,255,255,0.05); color: #ffffff; }
.stat-info { display: flex; flex-direction: column; }
.stat-value { font-size: 2rem; font-weight: 700; color: #ffffff; line-height: 1; }
.stat-label { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-top: 4px; }
.btn-luxe-outline {
    display: inline-flex;
    align-items: center;
    padding: 11px 22px;
    border: 1px solid rgba(197,168,128,0.4);
    color: #c5a880;
    background: transparent;
    border-radius: 4px;
    font-size: 12px;
    letter-spacing: 1px;
    text-decoration: none;
    transition: all 0.2s;
}
.btn-luxe-outline:hover { background: rgba(197,168,128,0.1); color: #c5a880; }
</style>
