<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LUXE LIVING ADMIN</title>

    <!-- Google Fonts: Playfair Display (Tiêu đề) & Montserrat (Nội dung) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <!-- Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="luxe-admin-container">
        <!-- SIDEBAR -->
        <aside class="luxe-sidebar">
            <div class="luxe-logo-zone">
                <div class="logo-box">
                    <i class="fa-solid fa-gem"></i>
                </div>
                <div class="logo-text">
                    <h2>LUXE</h2>
                    <span>LIVING ADMIN</span>
                </div>
            </div>

            <ul class="luxe-menu">
                <li>
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="luxe-menu-item">
                        <i class="fa-solid fa-grid-2x2"></i> Dashboard <i class="fa-solid fa-chevron-right ms-auto arrow-icon"></i>
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="luxe-menu-item">
                        <i class="fa-solid fa-box"></i> Sản phẩm
                    </a>
                </li>
                <li>
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="luxe-menu-item">
                        <i class="fa-solid fa-tags"></i> Danh mục
                    </a>
                </li>
                <li>
                    <a href="#" class="luxe-menu-item">
                        <i class="fa-solid fa-bag-shopping"></i> Đơn hàng
                    </a>
                </li>
                <li>
                    <a href="#" class="luxe-menu-item">
                        <i class="fa-solid fa-users"></i> Khách hàng
                    </a>
                </li>
                <li>
                    <a href="#" class="luxe-menu-item">
                        <i class="fa-solid fa-chart-simple"></i> Phân tích
                    </a>
                </li>
                <li>
                    <a href="#" class="luxe-menu-item">
                        <i class="fa-solid fa-gear"></i> Cài đặt
                    </a>
                </li>
            </ul>

            <div class="luxe-sidebar-footer">
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" id="logoutForm">
                    <button type="submit" class="footer-action-btn logout-btn-submit">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN AREA -->
        <div class="luxe-main-content">
            <!-- TOPBAR -->
            <header class="luxe-topbar">
                <div class="topbar-welcome">
                    <h1>@(ViewData["Title"] ?? "Tổng quan")</h1>
                    <p>Chào mừng trở lại, <strong>@User.Identity?.Name</strong></p>
                </div>

                <div class="topbar-actions">
                    <div class="luxe-search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="Tìm kiếm..." />
                    </div>

                    <a asp-area="" asp-controller="Product" asp-action="Index" class="luxe-notification-btn" title="Xem trang chủ">
                        <i class="fa-solid fa-house"></i>
                    </a>

                    <div class="luxe-profile-dropdown">
                        <div class="avatar-circle">A</div>
                        <div class="profile-info">
                            <span class="p-name">Admin</span>
                            <span class="p-role">Quản trị viên</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- TOAST NOTIFICATION -->
            @if (TempData["Success"] != null)
            {
                <div id="toast-success" style="
                    position:fixed;top:24px;right:24px;z-index:9999;
                    background:#1a2e1a;border:1px solid rgba(46,204,113,0.4);
                    color:#2ecc71;border-radius:6px;padding:14px 20px;
                    font-size:13px;display:flex;align-items:center;gap:10px;
                    box-shadow:0 8px 32px rgba(0,0,0,0.4);min-width:280px;
                    animation: slideIn 0.3s ease;">
                    <i class="fa-solid fa-check-circle"></i>
                    <span>@TempData["Success"]</span>
                    <button onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;margin-left:auto;font-size:16px;line-height:1;">×</button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div id="toast-error" style="
                    position:fixed;top:24px;right:24px;z-index:9999;
                    background:#2e1a1a;border:1px solid rgba(231,76,60,0.4);
                    color:#e74c3c;border-radius:6px;padding:14px 20px;
                    font-size:13px;display:flex;align-items:center;gap:10px;
                    box-shadow:0 8px 32px rgba(0,0,0,0.4);min-width:280px;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>@TempData["Error"]</span>
                    <button onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;margin-left:auto;font-size:16px;line-height:1;">×</button>
                </div>
            }

            <!-- VIEW CONTENT -->
            <main class="luxe-view-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <style>
    @@keyframes slideIn {
        from { opacity: 0; transform: translateX(20px); }
        to   { opacity: 1; transform: translateX(0); }
    }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss toast after 4 seconds
        setTimeout(function() {
            var t = document.getElementById('toast-success') || document.getElementById('toast-error');
            if (t) t.style.opacity = '0', t.style.transition = 'opacity 0.5s', setTimeout(function(){ if(t) t.remove(); }, 500);
        }, 4000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
